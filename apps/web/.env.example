# Same Supabase project as the API, but only the values that are safe in a browser bundle.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Base URL of the NestJS API. In development the Vite dev server proxies /api to it (see
# vite.config.ts), so this can usually stay as /api.
VITE_API_BASE_URL=/api
