# Postgres connection string for the Supabase project (Settings > Database > Connection string, "URI" mode, use the pooler connection for serverless-friendly access).
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Supabase project URL (Settings > API > Project URL).
SUPABASE_URL=https://xxxx.supabase.co

# Supabase anonymous public key (Settings > API > anon public). Safe to expose to the browser build.
SUPABASE_ANON_KEY=

# Supabase service role key (Settings > API > service_role secret). Server only. Never send to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase JWT secret used to verify access tokens on the API (Settings > API > JWT Settings).
SUPABASE_JWT_SECRET=

# Anthropic API key for document extraction, pre-close review and narrative drafting. Server only.
ANTHROPIC_API_KEY=

# Port the NestJS API listens on.
PORT=3000

# development | production | test
NODE_ENV=development
